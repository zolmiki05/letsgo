# ── Application ───────────────────────────────────────────────
# Port exposed on the host machine (container internal port is always 80)
APP_PORT=8080

# Optional: override the base URL used for invite links.
# Set this if you run behind a reverse proxy or with a custom domain.
# If left empty, the URL is auto-detected from the HTTP request.
# Example: https://letsgo.example.com
APP_URL=

# ── Database ───────────────────────────────────────────────────
DB_HOST=db
DB_NAME=letsgo
DB_USER=letsgo
DB_PASS=change_me_in_production
DB_ROOT_PASS=change_root_in_production
