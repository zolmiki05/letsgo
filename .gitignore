# Docker volumes
docker/mysql/data/

# Runtime storage (logs, setup output) – keep the directory, ignore contents
storage/*
!storage/.gitkeep

# Database backups created by upgrade.sh
backups/*
!backups/.gitkeep

# Environment – never commit real credentials
.env

# PHP
*.log
*.cache

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
